# =====================================================================
# Test environment configuration
# ---------------------------------------------------------------------
# 1. Copy this file to `.env` (never commit `.env`).
# 2. Fill in the values that match the environment you test against.
# 3. For the bundled local demo app, leave USERNAME/PASSWORD empty:
#    the demo server accepts admin / password123 by default.
# =====================================================================

# Environment to run against: dev | qa | stage | prod
ENV=dev

# Override the base URL. If empty, the value defined in
# src/config/environments/<env>.ts is used.
BASE_URL=

# Test credentials. NEVER commit real credentials.
# For non-local environments these are REQUIRED.
USERNAME=
PASSWORD=

# Browser: chromium | firefox | webkit
BROWSER=chromium

# Run headless: true | false
HEADLESS=true

# Default Playwright action timeout in milliseconds
DEFAULT_TIMEOUT=15000

# CI mode: true on CI servers (enables 1 retry by default)
CI=

# Parallel worker processes (defaults: 1 local, 4 CI)
WORKERS=

# Trace mode: off | on | retain-on-failure
TRACE=

# Screenshot mode: off | on | only-on-failure
SCREENSHOT=

# Video mode: off | on | retain-on-failure
VIDEO=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Port used by the bundled local demo app (dev only)
DEMO_SERVER_PORT=3100
